<Window x:Class="AstralTyper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AstralTyper Desktop - Typesetting &amp; Canvas Studio" Height="800" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkest}"
        Icon="app_icon.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Menu Bar -->
            <RowDefinition Height="Auto"/> <!-- Context Tool Options Bar -->
            <RowDefinition Height="*"/>    <!-- Main Workspace -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. Top Menu Bar -->
        <Menu Grid.Row="0" Background="{StaticResource BgHeader}" Foreground="{StaticResource FgPrimary}" Height="28">
            <MenuItem Header="_File">
                <MenuItem Header="_New Project" Click="MenuNew_Click" InputGestureText="Ctrl+N"/>
                <MenuItem Header="_Open Project (.atd)..." Click="MenuOpen_Click" InputGestureText="Ctrl+O"/>
                <Separator Background="{StaticResource BorderDark}"/>
                <MenuItem Header="_Save Project" Click="MenuSave_Click" InputGestureText="Ctrl+S"/>
                <MenuItem Header="Save _As..." Click="MenuSaveAs_Click"/>
                <Separator Background="{StaticResource BorderDark}"/>
                <MenuItem Header="_Import Image..." Click="MenuImportImage_Click"/>
                <MenuItem Header="Import _PDF Document..." Click="MenuImportPdf_Click"/>
                <Separator Background="{StaticResource BorderDark}"/>
                <MenuItem Header="_Export Image (PNG/JPG)..." Click="MenuExportImage_Click" InputGestureText="Ctrl+E"/>
                <MenuItem Header="Export _PDF Document..." Click="MenuExportPdf_Click"/>
                <Separator Background="{StaticResource BorderDark}"/>
                <MenuItem Header="E_xit" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" Click="MenuUndo_Click" InputGestureText="Ctrl+Z"/>
                <MenuItem Header="_Redo" Click="MenuRedo_Click" InputGestureText="Ctrl+Y"/>
                <Separator Background="{StaticResource BorderDark}"/>
                <MenuItem Header="_Duplicate Layer" Click="MenuDuplicateLayer_Click" InputGestureText="Ctrl+D"/>
                <MenuItem Header="_Delete Selected Layer" Click="MenuDeleteLayer_Click" InputGestureText="Delete"/>
                <Separator Background="{StaticResource BorderDark}"/>
                <MenuItem Header="_Clear Canvas" Click="MenuClearCanvas_Click"/>
            </MenuItem>
            <MenuItem Header="_Layer">
                <MenuItem Header="Add _Text Layer" Click="MenuAddText_Click"/>
                <MenuItem Header="Add _Shape Layer" Click="MenuAddShape_Click"/>
                <MenuItem Header="Add _Brush Layer" Click="MenuAddBrush_Click"/>
                <Separator Background="{StaticResource BorderDark}"/>
                <MenuItem Header="Bring to _Front" Click="MenuBringToFront_Click"/>
                <MenuItem Header="Move _Up" Click="MenuMoveUp_Click"/>
                <MenuItem Header="Move _Down" Click="MenuMoveDown_Click"/>
                <MenuItem Header="Send to _Back" Click="MenuSendToBack_Click"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Zoom In" Click="MenuZoomIn_Click" InputGestureText="Ctrl++"/>
                <MenuItem Header="Zoom _Out" Click="MenuZoomOut_Click" InputGestureText="Ctrl+-"/>
                <MenuItem Header="_Reset Zoom (100%)" Click="MenuResetZoom_Click" InputGestureText="Ctrl+0"/>
                <MenuItem Header="_Fit to Screen" Click="MenuFitScreen_Click"/>
            </MenuItem>
            <MenuItem Header="_Settings" Click="MenuSettings_Click"/>
            <MenuItem Header="_Help">
                <MenuItem Header="_About AstralTyper" Click="MenuAbout_Click"/>
            </MenuItem>
        </Menu>

        <!-- 2. Contextual Options Bar -->
        <Border Grid.Row="1" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,0,1" Padding="8,4">
            <StackPanel x:Name="ContextOptionsPanel" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Tool Options:" Foreground="{StaticResource FgMuted}" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>

                <!-- Dynamic controls depending on selected tool/layer -->
                <StackPanel x:Name="TextQuickOptions" Orientation="Horizontal" Visibility="Visible">
                    <TextBlock Text="Font:" Foreground="{StaticResource FgSecondary}" VerticalAlignment="Center" Margin="5,0"/>
                    <ComboBox x:Name="CmbQuickFont" Width="140" SelectionChanged="CmbQuickFont_SelectionChanged"/>

                    <TextBlock Text="Size:" Foreground="{StaticResource FgSecondary}" VerticalAlignment="Center" Margin="10,0,5,0"/>
                    <TextBox x:Name="TxtQuickFontSize" Width="45" Text="36" TextChanged="TxtQuickFontSize_TextChanged"/>

                    <Button x:Name="BtnQuickBold" Content="B" FontWeight="Bold" Width="26" Height="26" Margin="5,0,0,0" Click="BtnQuickBold_Click"/>
                    <Button x:Name="BtnQuickItalic" Content="I" FontStyle="Italic" Width="26" Height="26" Margin="2,0,0,0" Click="BtnQuickItalic_Click"/>

                    <TextBlock Text="Color:" Foreground="{StaticResource FgSecondary}" VerticalAlignment="Center" Margin="10,0,5,0"/>
                    <Button x:Name="BtnQuickColor" Width="24" Height="24" Background="White" BorderBrush="DarkGray" Click="BtnQuickColor_Click"/>
                </StackPanel>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="10,0"/>

                <StackPanel x:Name="BrushQuickOptions" Orientation="Horizontal">
                    <TextBlock Text="Brush Size:" Foreground="{StaticResource FgSecondary}" VerticalAlignment="Center" Margin="5,0"/>
                    <Slider x:Name="SldQuickBrushSize" Width="100" Minimum="1" Maximum="100" Value="10" ValueChanged="SldQuickBrushSize_ValueChanged"/>
                    <TextBlock x:Name="TxtQuickBrushSize" Text="10 px" Foreground="{StaticResource FgSecondary}" VerticalAlignment="Center" Margin="5,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 3. Main Workspace Area -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/> <!-- Left Vertical Toolbar -->
                <ColumnDefinition Width="*"/>    <!-- Center Canvas Area -->
                <ColumnDefinition Width="300"/>  <!-- Right Panel Dock -->
            </Grid.ColumnDefinitions>

            <!-- Left Photoshop Tool Palette -->
            <Border Grid.Column="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,1,0" Width="46">
                <StackPanel Margin="0,5">
                    <ToggleButton x:Name="ToolSelect" ToolTip="Select / Transform (V)" Style="{StaticResource ToolButtonStyle}" IsChecked="True" Click="Tool_Click">
                        <TextBlock Text="↖" FontSize="18"/>
                    </ToggleButton>
                    <ToggleButton x:Name="ToolText" ToolTip="Text Tool (T)" Style="{StaticResource ToolButtonStyle}" Click="Tool_Click">
                        <TextBlock Text="T" FontSize="18" FontWeight="Bold"/>
                    </ToggleButton>
                    <ToggleButton x:Name="ToolShape" ToolTip="Shape Tool (U)" Style="{StaticResource ToolButtonStyle}" Click="Tool_Click">
                        <TextBlock Text="▭" FontSize="18"/>
                    </ToggleButton>
                    <ToggleButton x:Name="ToolBrush" ToolTip="Brush Tool (B)" Style="{StaticResource ToolButtonStyle}" Click="Tool_Click">
                        <TextBlock Text="🖌" FontSize="16"/>
                    </ToggleButton>
                    <ToggleButton x:Name="ToolEraser" ToolTip="Eraser Tool (E)" Style="{StaticResource ToolButtonStyle}" Click="Tool_Click">
                        <TextBlock Text="⌫" FontSize="16"/>
                    </ToggleButton>
                    <ToggleButton x:Name="ToolEyedropper" ToolTip="Eyedropper Tool (I)" Style="{StaticResource ToolButtonStyle}" Click="Tool_Click">
                        <TextBlock Text="💧" FontSize="16"/>
                    </ToggleButton>
                    <ToggleButton x:Name="ToolInpaint" ToolTip="Magic Wand / Inpaint Eraser (W)" Style="{StaticResource ToolButtonStyle}" Click="Tool_Click">
                        <TextBlock Text="✨" FontSize="16"/>
                    </ToggleButton>
                    <Separator Background="{StaticResource BorderDark}" Margin="4,5"/>
                    <ToggleButton x:Name="ToolHand" ToolTip="Hand / Pan View (H)" Style="{StaticResource ToolButtonStyle}" Click="Tool_Click">
                        <TextBlock Text="✋" FontSize="16"/>
                    </ToggleButton>
                    <ToggleButton x:Name="ToolZoom" ToolTip="Zoom Tool (Z)" Style="{StaticResource ToolButtonStyle}" Click="Tool_Click">
                        <TextBlock Text="🔍" FontSize="16"/>
                    </ToggleButton>
                </StackPanel>
            </Border>

            <!-- Center Interactive Canvas Viewport -->
            <ScrollViewer Grid.Column="1" x:Name="CanvasScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          Background="{StaticResource BgDarkest}" Focusable="True"
                          PreviewMouseWheel="CanvasScrollViewer_PreviewMouseWheel">
                <Grid x:Name="CanvasContainer" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="50">
                    <!-- Canvas Element Host -->
                    <Border x:Name="CanvasBorder" BorderBrush="#555555" BorderThickness="1"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Canvas x:Name="MainCanvas" Width="1080" Height="1080" Background="#FFFFFF"
                                ClipToBounds="True"
                                MouseLeftButtonDown="MainCanvas_MouseLeftButtonDown"
                                MouseLeftButtonUp="MainCanvas_MouseLeftButtonUp"
                                MouseMove="MainCanvas_MouseMove">
                            <Canvas.LayoutTransform>
                                <ScaleTransform x:Name="CanvasScale" ScaleX="1.0" ScaleY="1.0"/>
                            </Canvas.LayoutTransform>
                        </Canvas>
                    </Border>
                </Grid>
            </ScrollViewer>

            <!-- Right Dock Panels -->
            <Border Grid.Column="2" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1,0,0,0">
                <TabControl Background="Transparent" BorderThickness="0" Foreground="{StaticResource FgPrimary}">
                    <!-- Tab 1: Layers -->
                    <TabItem Header="Layers" Style="{DynamicResource {x:Type TabItem}}">
                        <Grid Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Layer Controls Top -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock Text="Opacity:" VerticalAlignment="Center" Foreground="{StaticResource FgSecondary}" Margin="0,0,5,0"/>
                                <Slider x:Name="SldLayerOpacity" Width="100" Minimum="0" Maximum="1" Value="1" ValueChanged="SldLayerOpacity_ValueChanged"/>
                                <TextBlock x:Name="TxtLayerOpacity" Text="100%" VerticalAlignment="Center" Foreground="{StaticResource FgSecondary}" Margin="5,0"/>
                            </StackPanel>

                            <!-- Layer List -->
                            <ListView Grid.Row="1" x:Name="LstLayers" Background="{StaticResource BgMain}"
                                      SelectionChanged="LstLayers_SelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsVisible, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,5,0" ToolTip="Toggle Visibility"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource FgPrimary}"/>
                                            <Button Grid.Column="2" Content="🔒" Width="22" Height="22" Padding="0,0,0,0" Background="Transparent" BorderThickness="0"
                                                    ToolTip="Lock Layer" Click="BtnLockLayer_Click"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- Layer Actions Bottom -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                                <Button Content="+ Text" Click="MenuAddText_Click"/>
                                <Button Content="+ Shape" Click="MenuAddShape_Click"/>
                                <Button Content="▲" Width="26" ToolTip="Move Up" Click="MenuMoveUp_Click"/>
                                <Button Content="▼" Width="26" ToolTip="Move Down" Click="MenuMoveDown_Click"/>
                                <Button Content="📋" Width="26" ToolTip="Duplicate" Click="MenuDuplicateLayer_Click"/>
                                <Button Content="🗑" Width="26" ToolTip="Delete" Click="MenuDeleteLayer_Click"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <!-- Tab 2: Properties -->
                    <TabItem Header="Properties">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">
                                <!-- Text Layer Properties -->
                                <Expander Header="Text &amp; Typography" IsExpanded="True">
                                    <StackPanel Margin="5">
                                        <TextBlock Text="Content:" Foreground="{StaticResource FgSecondary}"/>
                                        <TextBox x:Name="TxtLayerTextContent" Height="60" TextWrapping="Wrap" AcceptsReturn="True" TextChanged="TxtLayerTextContent_TextChanged"/>

                                        <TextBlock Text="Font Family:" Foreground="{StaticResource FgSecondary}" Margin="0,8,0,0"/>
                                        <ComboBox x:Name="CmbFontFamily" SelectionChanged="CmbFontFamily_SelectionChanged"/>

                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                                <TextBlock Text="Font Size:" Foreground="{StaticResource FgSecondary}"/>
                                                <TextBox x:Name="TxtFontSize" Text="36" TextChanged="TxtFontSize_TextChanged"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                                <TextBlock Text="Spacing:" Foreground="{StaticResource FgSecondary}"/>
                                                <TextBox x:Name="TxtLetterSpacing" Text="0" TextChanged="TxtLetterSpacing_TextChanged"/>
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button x:Name="BtnTextBold" Content="Bold" Width="60" Click="BtnQuickBold_Click"/>
                                            <Button x:Name="BtnTextItalic" Content="Italic" Width="60" Click="BtnQuickItalic_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>

                                <!-- Fill & Stroke -->
                                <Expander Header="Fill &amp; Stroke Options" IsExpanded="True" Margin="0,5,0,0">
                                    <StackPanel Margin="5">
                                        <TextBlock Text="Fill Color:" Foreground="{StaticResource FgSecondary}"/>
                                        <Button x:Name="BtnFillColor" Height="25" Background="#FFFFFF" Click="BtnFillColor_Click"/>

                                        <TextBlock Text="Stroke Color:" Foreground="{StaticResource FgSecondary}" Margin="0,8,0,0"/>
                                        <Button x:Name="BtnStrokeColor" Height="25" Background="#000000" Click="BtnStrokeColor_Click"/>

                                        <TextBlock Text="Stroke Width:" Foreground="{StaticResource FgSecondary}" Margin="0,8,0,0"/>
                                        <Slider x:Name="SldStrokeWidth" Minimum="0" Maximum="50" Value="0" ValueChanged="SldStrokeWidth_ValueChanged"/>
                                    </StackPanel>
                                </Expander>

                                <!-- Manual D-Pad Shifts -->
                                <Expander Header="Letter Position Shift" IsExpanded="False" Margin="0,5,0,0">
                                    <Grid Margin="5">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Row="0" Grid.Column="1" Content="▲" Click="BtnShiftUp_Click"/>
                                        <Button Grid.Row="1" Grid.Column="0" Content="◄" Click="BtnShiftLeft_Click"/>
                                        <Button Grid.Row="1" Grid.Column="1" Content="•" Click="BtnShiftReset_Click"/>
                                        <Button Grid.Row="1" Grid.Column="2" Content="►" Click="BtnShiftRight_Click"/>
                                        <Button Grid.Row="2" Grid.Column="1" Content="▼" Click="BtnShiftDown_Click"/>
                                    </Grid>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 3: Effects & Warp -->
                    <TabItem Header="Effects &amp; Warp">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">
                                <Expander Header="Drop Shadow" IsExpanded="False">
                                    <StackPanel Margin="5">
                                        <CheckBox x:Name="ChkDropShadow" Content="Enable Drop Shadow" Foreground="{StaticResource FgPrimary}" Checked="FxParam_Changed" Unchecked="FxParam_Changed"/>
                                        <TextBlock Text="Blur Radius:" Foreground="{StaticResource FgSecondary}" Margin="0,5,0,0"/>
                                        <Slider x:Name="SldShadowBlur" Minimum="0" Maximum="50" Value="10" ValueChanged="FxParam_Changed"/>
                                        <TextBlock Text="Offset X/Y:" Foreground="{StaticResource FgSecondary}" Margin="0,5,0,0"/>
                                        <Slider x:Name="SldShadowOffsetX" Minimum="-50" Maximum="50" Value="5" ValueChanged="FxParam_Changed"/>
                                        <Slider x:Name="SldShadowOffsetY" Minimum="-50" Maximum="50" Value="5" ValueChanged="FxParam_Changed"/>
                                    </StackPanel>
                                </Expander>

                                <Expander Header="Neon Glow" IsExpanded="False" Margin="0,5,0,0">
                                    <StackPanel Margin="5">
                                        <CheckBox x:Name="ChkNeonGlow" Content="Enable Neon Glow" Foreground="{StaticResource FgPrimary}" Checked="FxParam_Changed" Unchecked="FxParam_Changed"/>
                                        <TextBlock Text="Glow Radius:" Foreground="{StaticResource FgSecondary}" Margin="0,5,0,0"/>
                                        <Slider x:Name="SldNeonRadius" Minimum="0" Maximum="50" Value="15" ValueChanged="FxParam_Changed"/>
                                    </StackPanel>
                                </Expander>

                                <Expander Header="Warp &amp; Perspective Mesh" IsExpanded="True" Margin="0,5,0,0">
                                    <StackPanel Margin="5">
                                        <CheckBox x:Name="ChkWarpActive" Content="Enable Mesh Warp" Foreground="{StaticResource FgPrimary}" Checked="ChkWarpActive_Changed" Unchecked="ChkWarpActive_Changed"/>
                                        <TextBlock Text="Preset Warp Deformations:" Foreground="{StaticResource FgSecondary}" Margin="0,8,0,0"/>
                                        <ComboBox x:Name="CmbWarpPresets" SelectionChanged="CmbWarpPresets_SelectionChanged">
                                            <ComboBoxItem Content="None / Reset"/>
                                            <ComboBoxItem Content="Arc Up"/>
                                            <ComboBoxItem Content="Arc Down"/>
                                            <ComboBoxItem Content="Bulge"/>
                                            <ComboBoxItem Content="Pinch"/>
                                            <ComboBoxItem Content="Wave"/>
                                            <ComboBoxItem Content="Flag"/>
                                            <ComboBoxItem Content="S-Curve"/>
                                        </ComboBox>

                                        <TextBlock Text="Warp Intensity / Strength:" Foreground="{StaticResource FgSecondary}" Margin="0,8,0,0"/>
                                        <Slider x:Name="SldWarpStrength" Minimum="-100" Maximum="100" Value="30" ValueChanged="SldWarpStrength_ValueChanged"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 4: Styles -->
                    <TabItem Header="Styles">
                        <Grid Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Button Grid.Row="0" Content="+ Save Current Style" Margin="0,0,0,5" Click="BtnSaveStyle_Click"/>
                            <ListBox Grid.Row="1" x:Name="LstStyles" Background="{StaticResource BgMain}" SelectionChanged="LstStyles_SelectionChanged">
                                <!-- Visual style presets -->
                            </ListBox>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- 4. Status Bar -->
        <Border Grid.Row="3" Background="{StaticResource BgHeader}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,1,0,0" Height="24" Padding="8,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusInfo" Text="Ready" Foreground="{StaticResource FgSecondary}" FontSize="11"/>
                    <TextBlock x:Name="StatusCoords" Text=" | X: 0, Y: 0" Foreground="{StaticResource FgMuted}" FontSize="11"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusZoom" Text="100%" Foreground="{StaticResource FgSecondary}" FontSize="11" Margin="0,0,10,0"/>
                    <TextBlock Text="1080 x 1080 px" Foreground="{StaticResource FgMuted}" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
