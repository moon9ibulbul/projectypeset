<Window x:Class="AstralTyper.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AstralTyper Desktop Settings" Height="400" Width="500"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgDarkest}"
        ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Application Settings &amp; Preferences" Foreground="{StaticResource FgPrimary}" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Expander Header="Canvas &amp; Export Defaults" IsExpanded="True" Margin="0,0,0,10">
                    <StackPanel Margin="10">
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Default Canvas Width:" Foreground="{StaticResource FgSecondary}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="TxtDefaultWidth" Text="1080"/>
                        </Grid>

                        <Grid Margin="0,5,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Default Canvas Height:" Foreground="{StaticResource FgSecondary}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="TxtDefaultHeight" Text="1080"/>
                        </Grid>
                    </StackPanel>
                </Expander>

                <Expander Header="Performance &amp; Rendering" IsExpanded="True" Margin="0,0,0,10">
                    <StackPanel Margin="10">
                        <CheckBox x:Name="ChkHardwareAcceleration" Content="Enable Hardware Acceleration (WPF RenderPipeline)" IsChecked="True" Foreground="{StaticResource FgPrimary}"/>
                        <CheckBox x:Name="ChkHighDpiScaling" Content="Enable High-DPI Quality Scaling" IsChecked="True" Foreground="{StaticResource FgPrimary}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Expander>

                <Expander Header="Theme &amp; Visuals" IsExpanded="True">
                    <StackPanel Margin="10">
                        <TextBlock Text="Active Theme:" Foreground="{StaticResource FgSecondary}" Margin="0,0,0,5"/>
                        <ComboBox x:Name="CmbTheme" SelectedIndex="0">
                            <ComboBoxItem Content="Photoshop Dark (Default)"/>
                            <ComboBoxItem Content="Modern Charcoal"/>
                            <ComboBoxItem Content="Deep Purple Accent"/>
                        </ComboBox>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Save Settings" Width="100" Click="BtnSave_Click" IsDefault="True"/>
            <Button Content="Cancel" Width="80" Margin="10,0,0,0" Click="BtnCancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
