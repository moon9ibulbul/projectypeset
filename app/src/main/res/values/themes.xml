<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base Dark Grey (Default) -->
    <style name="Theme.AstralTyper" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">#121212</item>
        <item name="android:windowBackground">#121212</item>

        <!-- Custom Attributes -->
        <item name="appBackgroundColor">#121212</item>
        <item name="appSurfaceColor">#1E1E1E</item>
        <item name="appTextColorPrimary">#FFFFFF</item>
        <item name="appTextColorSecondary">#AAAAAA</item>
        <item name="appIconTint">#FFFFFF</item>
    </style>

    <!-- Pitch Black -->
    <style name="Theme.AstralTyper.PitchBlack" parent="Theme.AstralTyper">
        <item name="android:statusBarColor">#000000</item>
        <item name="android:windowBackground">#000000</item>

        <item name="appBackgroundColor">#000000</item>
        <item name="appSurfaceColor">#0D0D0D</item>
        <item name="appTextColorPrimary">#FFFFFF</item>
        <item name="appTextColorSecondary">#AAAAAA</item>
        <item name="appIconTint">#FFFFFF</item>
    </style>

    <!-- Light Grey -->
    <style name="Theme.AstralTyper.LightGrey" parent="Theme.AstralTyper">
        <item name="android:statusBarColor">#2A2A2A</item>
        <item name="android:windowBackground">#2A2A2A</item>

        <item name="appBackgroundColor">#2A2A2A</item>
        <item name="appSurfaceColor">#3A3A3A</item>
        <item name="appTextColorPrimary">#FFFFFF</item>
        <item name="appTextColorSecondary">#CCCCCC</item>
        <item name="appIconTint">#FFFFFF</item>
    </style>

    <!-- Light -->
    <style name="Theme.AstralTyper.Light" parent="Theme.AstralTyper">
        <item name="android:statusBarColor">#F5F5F5</item>
        <item name="android:windowBackground">#F5F5F5</item>

        <item name="appBackgroundColor">#F5F5F5</item>
        <item name="appSurfaceColor">#FFFFFF</item>
        <item name="appTextColorPrimary">#000000</item>
        <item name="appTextColorSecondary">#666666</item>
        <item name="appIconTint">#333333</item>
    </style>

    <!-- Cream -->
    <style name="Theme.AstralTyper.Cream" parent="Theme.AstralTyper">
        <item name="android:statusBarColor">#FFFDD0</item>
        <item name="android:windowBackground">#FFFDD0</item>

        <item name="appBackgroundColor">#FFFDD0</item>
        <item name="appSurfaceColor">#FAF6B8</item>
        <item name="appTextColorPrimary">#4A3B2C</item>
        <item name="appTextColorSecondary">#7A6A56</item>
        <item name="appIconTint">#4A3B2C</item>
    </style>

    <!-- Sunset -->
    <style name="Theme.AstralTyper.Sunset" parent="Theme.AstralTyper">
        <item name="android:statusBarColor">#2E151B</item>
        <item name="android:windowBackground">#2E151B</item>

        <item name="appBackgroundColor">#2E151B</item>
        <item name="appSurfaceColor">#3D1B26</item>
        <item name="appTextColorPrimary">#FDE2D9</item>
        <item name="appTextColorSecondary">#D9B3A9</item>
        <item name="appIconTint">#FDE2D9</item>
    </style>

    <!-- Pink -->
    <style name="Theme.AstralTyper.Pink" parent="Theme.AstralTyper">
        <item name="android:statusBarColor">#FCE4EC</item>
        <item name="android:windowBackground">#FCE4EC</item>

        <item name="appBackgroundColor">#FCE4EC</item>
        <item name="appSurfaceColor">#F8BBD0</item>
        <item name="appTextColorPrimary">#880E4F</item>
        <item name="appTextColorSecondary">#AD1457</item>
        <item name="appIconTint">#880E4F</item>
    </style>
</resources>
