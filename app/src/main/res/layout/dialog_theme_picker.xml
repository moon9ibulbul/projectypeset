<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="?attr/appSurfaceColor">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select Theme"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="?attr/appTextColorPrimary"
        android:layout_marginBottom="16dp"/>

    <RadioGroup
        android:id="@+id/rgThemes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioButton
            android:id="@+id/rbThemeDarkGrey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dark Grey"
            android:textColor="?attr/appTextColorPrimary"/>

        <RadioButton
            android:id="@+id/rbThemePitchBlack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pitch Black"
            android:textColor="?attr/appTextColorPrimary"/>

        <RadioButton
            android:id="@+id/rbThemeLightGrey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Light Grey"
            android:textColor="?attr/appTextColorPrimary"/>

        <RadioButton
            android:id="@+id/rbThemeLight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Light"
            android:textColor="?attr/appTextColorPrimary"/>

        <RadioButton
            android:id="@+id/rbThemeCream"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cream"
            android:textColor="?attr/appTextColorPrimary"/>

        <RadioButton
            android:id="@+id/rbThemeSunset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sunset"
            android:textColor="?attr/appTextColorPrimary"/>

        <RadioButton
            android:id="@+id/rbThemePink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pink"
            android:textColor="?attr/appTextColorPrimary"/>
    </RadioGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/btnCancelTheme"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:backgroundTint="?attr/appSurfaceColor"
            android:textColor="?attr/appTextColorSecondary"/>

        <Button
            android:id="@+id/btnApplyTheme"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Apply"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
</LinearLayout>
