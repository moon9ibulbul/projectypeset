<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Primary Stroke Width"
        android:textColor="?attr/appTextColorPrimary"
        android:textSize="12sp" />

    <SeekBar
        android:id="@+id/sbStrokeWidth"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="50"
        android:progress="12"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnStrokeColor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select Stroke Color"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Double Stroke Width"
        android:textColor="?attr/appTextColorPrimary"
        android:textSize="12sp" />

    <SeekBar
        android:id="@+id/sbDoubleWidth"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="60"
        android:progress="24"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnDoubleColor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select Double Stroke Color"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

</LinearLayout>
