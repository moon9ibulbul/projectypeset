<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBackgroundColor"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="?attr/appTextColorPrimary"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>


        <!-- Theme Settings -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Theme Settings"
            android:textColor="?attr/appTextColorSecondary"
            android:textSize="14sp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnChangeTheme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Change Theme"
            android:textColor="?attr/appTextColorPrimary"
            android:backgroundTint="?attr/appSurfaceColor"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp" />

        <!-- Data Management -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Data Management"
            android:textColor="?attr/appTextColorSecondary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <CheckBox
            android:id="@+id/cbStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Style List"
            android:textColor="?attr/appTextColorPrimary"
            android:checked="true"/>

        <CheckBox
            android:id="@+id/cbFavorite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Favorites &amp; Custom Categories (Fonts)"
            android:textColor="?attr/appTextColorPrimary"
            android:checked="true"/>

        <CheckBox
            android:id="@+id/cbMyFont"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Fonts (Files)"
            android:textColor="?attr/appTextColorPrimary"
            android:checked="true"/>

        <CheckBox
            android:id="@+id/cbWarpPreset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Custom Warp Presets"
            android:textColor="?attr/appTextColorPrimary"
            android:checked="true"/>

        <CheckBox
            android:id="@+id/cbAutosave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enable Autosave"
            android:textColor="?attr/appTextColorPrimary"
            android:checked="true"/>

        <CheckBox
            android:id="@+id/cbDisableSnap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Disable Snap to Center"
            android:textColor="?attr/appTextColorPrimary"
            android:checked="false"/>

        <CheckBox
            android:id="@+id/cbDisableFastInteraction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Disable Fast Interaction Mode (Zoom/Pan Optimization)"
            android:textColor="?attr/appTextColorPrimary"
            android:checked="false"/>

        <CheckBox
            android:id="@+id/cbDisableLOD"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Disable Level of Detail &amp; Quality Scaling"
            android:textColor="?attr/appTextColorPrimary"
            android:checked="false"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/btnExport"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Export Data"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnImport"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Import Data"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <!-- Font Manager -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Font Manager"
            android:textColor="?attr/appTextColorSecondary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnFontManager"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Open Font Manager"
            android:layout_marginBottom="24dp"/>

        <!-- Cache -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cache"
            android:textColor="?attr/appTextColorSecondary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/tvCacheSize"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cache Size: Calculating..."
                android:textColor="?attr/appTextColorPrimary"/>

            <Button
                android:id="@+id/btnClearCache"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clear Cache"/>
        </LinearLayout>

        <!-- Inpaint Model -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Inpaint Model (LaMa)"
            android:textColor="?attr/appTextColorSecondary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <CheckBox
                android:id="@+id/cbLamaNnapi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enable NNAPI (Hardware Acceleration)"
                android:textColor="?attr/appTextColorPrimary"
                android:checked="true"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvModelStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status: Checking..."
                android:textColor="?attr/appTextColorPrimary"
                android:layout_marginBottom="8dp"/>

            <ProgressBar
                android:id="@+id/pbModelDownload"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnDownloadModel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Download Model"/>
        </LinearLayout>

        <!-- Inpaint Model MIGAN -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Inpaint Model (MIGAN)"
            android:textColor="?attr/appTextColorSecondary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvMiganModelStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status: Checking..."
                android:textColor="?attr/appTextColorPrimary"
                android:layout_marginBottom="8dp"/>

            <ProgressBar
                android:id="@+id/pbMiganModelDownload"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnDownloadMiganModel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Download Model"/>
        </LinearLayout>

        <!-- Typer Model -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bubble &amp; Text Detector"
            android:textColor="?attr/appTextColorSecondary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/tvTyperModelStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status: Checking..."
                android:textColor="?attr/appTextColorPrimary"
                android:layout_marginBottom="8dp"/>

            <ProgressBar
                android:id="@+id/pbTyperModelDownload"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnDownloadTyperModel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Download Model"/>

            <!-- Int8 Model UI -->
            <TextView
                android:id="@+id/tvTyperInt8ModelStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status: Checking..."
                android:textColor="?attr/appTextColorPrimary"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"/>

            <ProgressBar
                android:id="@+id/pbTyperInt8ModelDownload"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnDownloadTyperInt8Model"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Download Int8 Model"/>

            <LinearLayout
                android:id="@+id/layoutTyperModelSelect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select Model Version"
                    android:textColor="?attr/appTextColorSecondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp"/>

                <Spinner
                    android:id="@+id/spinnerTyperModelSelect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="?attr/appIconTint"/>
            </LinearLayout>

            <!-- Inpaint Text Detection Settings -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inpaint Text Detection"
                android:textColor="?attr/appTextColorSecondary"
                android:textSize="12sp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp"/>

            <CheckBox
                android:id="@+id/cbInpaintDetectTextInside"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Text Inside Bubble"
                android:textColor="?attr/appTextColorPrimary"/>

            <CheckBox
                android:id="@+id/cbInpaintDetectTextOutside"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Text Outside Bubble"
                android:textColor="?attr/appTextColorPrimary"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Text Mask Shape"
                android:textColor="?attr/appTextColorSecondary"
                android:textSize="12sp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"/>

            <RadioGroup
                android:id="@+id/rgInpaintMaskShape"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbMaskRectangle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rectangle"
                    android:textColor="?attr/appTextColorPrimary"/>

                <RadioButton
                    android:id="@+id/rbMaskRounded"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rounded"
                    android:textColor="?attr/appTextColorPrimary"
                    android:layout_marginStart="16dp"/>
            </RadioGroup>

            <TextView
                android:id="@+id/tvInpaintMaskPadding"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mask Padding: 0px"
                android:textColor="?attr/appTextColorPrimary"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/btnMinusInpaintPadding"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:text="−"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:textColor="?attr/appTextColorPrimary"
                    android:background="@drawable/bg_button_dynamic" />

                <SeekBar
                    android:id="@+id/sbInpaintMaskPadding"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="40"
                    android:progress="20"/>

                <TextView
                    android:id="@+id/btnPlusInpaintPadding"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:text="+"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:textColor="?attr/appTextColorPrimary"
                    android:background="@drawable/bg_button_dynamic" />
            </LinearLayout>

        </LinearLayout>

        <!-- Watermark -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Watermark"
            android:textColor="?attr/appTextColorSecondary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <CheckBox
            android:id="@+id/cbEnableWatermark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enable Global Watermark"
            android:textColor="?attr/appTextColorPrimary"/>

        <LinearLayout
            android:id="@+id/layoutWatermarkOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/btnImportWatermark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Import Watermark"
                android:layout_marginBottom="8dp"/>

            <ImageView
                android:id="@+id/ivWatermarkPreview"
                android:layout_width="wrap_content"
                android:layout_height="100dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:layout_marginBottom="16dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/tvWatermarkOpacity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Watermark Opacity: 100%"
                android:textColor="?attr/appTextColorPrimary"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/btnMinusWatermarkOpacity"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:text="−"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:textColor="?attr/appTextColorPrimary"
                    android:background="@drawable/bg_button_dynamic" />

                <SeekBar
                    android:id="@+id/sbWatermarkOpacity"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="255"
                    android:progress="255"/>

                <TextView
                    android:id="@+id/btnPlusWatermarkOpacity"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:text="+"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:textColor="?attr/appTextColorPrimary"
                    android:background="@drawable/bg_button_dynamic" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/cbAutoWatermark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Auto Watermark"
                android:textColor="?attr/appTextColorPrimary"/>

            <CheckBox
                android:id="@+id/cbWatermarkAutoScaling"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Auto Scaling"
                android:textColor="?attr/appTextColorPrimary"
                android:layout_marginTop="8dp"/>

            <LinearLayout
                android:id="@+id/layoutWatermarkScale"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tvWatermarkScale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Watermark Scale Factor: 25%"
                    android:textColor="?attr/appTextColorPrimary"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/btnMinusWatermarkScale"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:text="−"
                        android:textSize="16sp"
                        android:gravity="center"
                        android:textColor="?attr/appTextColorPrimary"
                        android:background="@drawable/bg_button_dynamic" />

                    <SeekBar
                        android:id="@+id/sbWatermarkScale"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="100"
                        android:progress="25"/>

                    <TextView
                        android:id="@+id/btnPlusWatermarkScale"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:text="+"
                        android:textSize="16sp"
                        android:gravity="center"
                        android:textColor="?attr/appTextColorPrimary"
                        android:background="@drawable/bg_button_dynamic" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutWatermarkPosition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Watermark Position"
                    android:textColor="?attr/appTextColorSecondary"
                    android:textSize="12sp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="4dp"/>

                <Spinner
                    android:id="@+id/spinnerWatermarkPosition"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="?attr/appIconTint"/>
            </LinearLayout>
        </LinearLayout>

        <!-- PDF Export Settings -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pdf_export_settings"
            android:textColor="?attr/appTextColorSecondary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/tvPdfQuality"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PDF Compression Quality: 80%"
                android:textColor="?attr/appTextColorPrimary"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pdf_quality_summary"
                android:textColor="?attr/appTextColorSecondary"
                android:textSize="12sp"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/btnMinusPdfQuality"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:text="−"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:textColor="?attr/appTextColorPrimary"
                    android:background="@drawable/bg_button_dynamic" />

                <SeekBar
                    android:id="@+id/sbPdfQuality"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="80"/>

                <TextView
                    android:id="@+id/btnPlusPdfQuality"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:text="+"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:textColor="?attr/appTextColorPrimary"
                    android:background="@drawable/bg_button_dynamic" />
            </LinearLayout>
        </LinearLayout>

        <!-- About / Donate -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <Button
            android:id="@+id/btnDonate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Donate Me"
            android:backgroundTint="#FF9800"
            android:textColor="?attr/appTextColorPrimary"
            android:textStyle="bold"/>

    </LinearLayout>
</ScrollView>
