<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBackgroundColor"
    tools:context=".EditorActivity">

    <!-- Top Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/appSurfaceColor"
        android:paddingHorizontal="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="?attr/appIconTint"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnUndo"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/btnUndo"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_rotate"
            android:scaleX="-1"
            app:tint="?attr/appIconTint"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintEnd_toStartOf="@id/btnRedo"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/btnRedo"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_rotate"
            app:tint="?attr/appIconTint"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnUndo"
            app:layout_constraintEnd_toStartOf="@id/btnAdd"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/btnAdd"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_input_add"
            app:tint="?attr/appIconTint"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnRedo"
            app:layout_constraintEnd_toStartOf="@id/btnTopTyper"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/btnTopTyper"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_typer"
            app:tint="?attr/appIconTint"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnAdd"
            app:layout_constraintEnd_toStartOf="@id/btnEraser"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/btnEraser"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_eraser"
            app:tint="?attr/appIconTint"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnTopTyper"
            app:layout_constraintEnd_toStartOf="@id/btnCut"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/btnCut"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_crop"
            app:tint="?attr/appIconTint"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnEraser"
            app:layout_constraintEnd_toStartOf="@id/btnLayers"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/btnLayers"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_sort_by_size"
            app:tint="?attr/appIconTint"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnCut"
            app:layout_constraintEnd_toStartOf="@id/btnSave"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/btnSave"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_save"
            app:tint="?attr/appIconTint"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnLayers"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Canvas Area -->
    <FrameLayout
        android:id="@+id/canvasContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/bottomMenuContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

    </FrameLayout>

    <!-- Bottom Menu Container -->
    <FrameLayout
        android:id="@+id/bottomMenuContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Default Insert Menu -->
        <LinearLayout
            android:id="@+id/menuInsert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/appSurfaceColor"
            android:orientation="horizontal"
            android:paddingVertical="6dp"
            android:paddingHorizontal="8dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:id="@+id/btnInsertText"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingVertical="4dp"
                android:paddingHorizontal="4dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_menu_text"
                    app:tint="?attr/appIconTint" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Text"
                    android:textSize="10sp"
                    android:textColor="?attr/appTextColorPrimary"
                    android:singleLine="true" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnInsertImage"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingVertical="4dp"
                android:paddingHorizontal="4dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_menu_image"
                    app:tint="?attr/appIconTint" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Image"
                    android:textSize="10sp"
                    android:textColor="?attr/appTextColorPrimary"
                    android:singleLine="true" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnInsertShape"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingVertical="4dp"
                android:paddingHorizontal="4dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_crop_square"
                    app:tint="?attr/appIconTint" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Shape"
                    android:textSize="10sp"
                    android:textColor="?attr/appTextColorPrimary"
                    android:singleLine="true" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnInsertBrush"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingVertical="4dp"
                android:paddingHorizontal="4dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_brush"
                    app:tint="?attr/appIconTint" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Brush"
                    android:textSize="10sp"
                    android:textColor="?attr/appTextColorPrimary"
                    android:singleLine="true" />
            </LinearLayout>

        </LinearLayout>

        <!-- Properties Menu (Hidden by default) -->
        <HorizontalScrollView
            android:id="@+id/menuProperties"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/appSurfaceColor"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="6dp"
                android:paddingHorizontal="8dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:id="@+id/btnPropQuickEdit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingVertical="4dp"
                    android:paddingHorizontal="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_pencil"
                        app:tint="?attr/appIconTint" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Quick Edit"
                        android:textSize="10sp"
                        android:textColor="?attr/appTextColorPrimary"
                        android:singleLine="true" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnPropStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingVertical="4dp"
                    android:paddingHorizontal="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_menu_palette"
                        app:tint="?attr/appIconTint" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/style"
                        android:textSize="10sp"
                        android:textColor="?attr/appTextColorPrimary"
                        android:singleLine="true" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnPropFont"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingVertical="4dp"
                    android:paddingHorizontal="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_menu_font"
                        app:tint="?attr/appIconTint" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/font"
                        android:textSize="10sp"
                        android:textColor="?attr/appTextColorPrimary"
                        android:singleLine="true" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnPropFormat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingVertical="4dp"
                    android:paddingHorizontal="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_menu_format"
                        app:tint="?attr/appIconTint" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/format"
                        android:textSize="10sp"
                        android:textColor="?attr/appTextColorPrimary"
                        android:singleLine="true" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnPropColor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingVertical="4dp"
                    android:paddingHorizontal="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_menu_color"
                        app:tint="?attr/appIconTint" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/color"
                        android:textSize="10sp"
                        android:textColor="?attr/appTextColorPrimary"
                        android:singleLine="true" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnPropBrush"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingVertical="4dp"
                    android:paddingHorizontal="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_brush"
                        app:tint="?attr/appIconTint" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Brush"
                        android:textSize="10sp"
                        android:textColor="?attr/appTextColorPrimary"
                        android:singleLine="true" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnPropSpacing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingVertical="4dp"
                    android:paddingHorizontal="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_menu_spacing"
                        app:tint="?attr/appIconTint" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Spacing"
                        android:textSize="10sp"
                        android:textColor="?attr/appTextColorPrimary"
                        android:singleLine="true" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnPropStroke"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingVertical="4dp"
                    android:paddingHorizontal="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_menu_stroke"
                        app:tint="?attr/appIconTint" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/stroke"
                        android:textSize="10sp"
                        android:textColor="?attr/appTextColorPrimary"
                        android:singleLine="true" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnPropDoubleStroke"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingVertical="4dp"
                    android:paddingHorizontal="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_menu_double_stroke"
                        app:tint="?attr/appIconTint" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Double Stroke"
                        android:textSize="10sp"
                        android:textColor="?attr/appTextColorPrimary"
                        android:singleLine="true" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnPropShadow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingVertical="4dp"
                    android:paddingHorizontal="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_menu_shadow"
                        app:tint="?attr/appIconTint" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/shadow"
                        android:textSize="10sp"
                        android:textColor="?attr/appTextColorPrimary"
                        android:singleLine="true" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnPropGradation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingVertical="4dp"
                    android:paddingHorizontal="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_menu_gradation"
                        app:tint="?attr/appIconTint" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/gradation"
                        android:textSize="10sp"
                        android:textColor="?attr/appTextColorPrimary"
                        android:singleLine="true" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnPropEffect"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingVertical="4dp"
                    android:paddingHorizontal="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_magic_wand"
                        app:tint="?attr/appIconTint" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Effect"
                        android:textSize="10sp"
                        android:textColor="?attr/appTextColorPrimary"
                        android:singleLine="true" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnPropTexture"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingVertical="4dp"
                    android:paddingHorizontal="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_menu_texture"
                        app:tint="?attr/appIconTint" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Texture"
                        android:textSize="10sp"
                        android:textColor="?attr/appTextColorPrimary"
                        android:singleLine="true" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnPropOpacity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingVertical="4dp"
                    android:paddingHorizontal="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_menu_opacity"
                        app:tint="?attr/appIconTint" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Opacity"
                        android:textSize="10sp"
                        android:textColor="?attr/appTextColorPrimary"
                        android:singleLine="true" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnPropErase"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingVertical="4dp"
                    android:paddingHorizontal="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_eraser"
                        app:tint="?attr/appIconTint" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Erase"
                        android:textSize="10sp"
                        android:textColor="?attr/appTextColorPrimary"
                        android:singleLine="true" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnPropPerspective"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingVertical="4dp"
                    android:paddingHorizontal="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_menu_perspective"
                        app:tint="?attr/appIconTint" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Perspective"
                        android:textSize="10sp"
                        android:textColor="?attr/appTextColorPrimary"
                        android:singleLine="true" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnPropWarp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingVertical="4dp"
                    android:paddingHorizontal="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_menu_warp"
                        app:tint="?attr/appIconTint" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Warp"
                        android:textSize="10sp"
                        android:textColor="?attr/appTextColorPrimary"
                        android:singleLine="true" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnPropPuppetWarp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingVertical="4dp"
                    android:paddingHorizontal="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_menu_puppet_warp"
                        app:tint="?attr/appIconTint" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Puppet Warp"
                        android:textSize="10sp"
                        android:textColor="?attr/appTextColorPrimary"
                        android:singleLine="true" />
                </LinearLayout>

            </LinearLayout>
        </HorizontalScrollView>

    </FrameLayout>

    <!-- Property Detail Panel (e.g. Color Picker) - Overlay -->
    <FrameLayout
        android:id="@+id/propertyDetailContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/appSurfaceColor"
        app:layout_constraintBottom_toTopOf="@id/bottomMenuContainer"
        android:visibility="gone">

        <!-- Placeholder for details -->
        <TextView
             android:id="@+id/tvDetailTitle"
             android:layout_width="match_parent"
             android:layout_height="100dp"
             android:text="Detail Panel"
             android:gravity="center"
             android:textColor="?attr/appTextColorPrimary"/>

    </FrameLayout>

    <!-- Save Sidebar Stub/Include -->
    <include
        android:id="@+id/saveSidebar"
        layout="@layout/layout_sidebar_save"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"/>

    <!-- Loading Indicator -->
    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:indeterminateTint="?attr/appIconTint"/>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
