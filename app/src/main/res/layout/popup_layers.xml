<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appSurfaceColor"
    android:orientation="vertical"
    android:padding="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="0dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tvLayersTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Layers"
            android:textColor="?attr/appTextColorPrimary"
            android:textSize="14sp"
            android:gravity="start"/>

        <TextView
            android:id="@+id/btnToggleMultiSelect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Multi"
            android:textSize="11sp"
            android:textColor="?attr/appTextColorPrimary"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="#33888888"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/multiSelectActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvMultiSelectedCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 selected"
            android:textSize="11sp"
            android:textColor="#00BCD4"/>

        <ImageView
            android:id="@+id/btnMultiSelectAll"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:padding="4dp"
            android:src="@drawable/ic_select_all"
            android:background="#33888888"
            android:contentDescription="Select all layers"
            app:tint="?attr/appIconTint"/>

        <ImageView
            android:id="@+id/btnMultiUnselectAll"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="4dp"
            android:padding="4dp"
            android:src="@drawable/ic_remove_selection"
            android:background="#33888888"
            android:contentDescription="Unselect all layers"
            app:tint="?attr/appIconTint"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#444"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerLayers"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical"/>

</LinearLayout>
