--- app/src/main/java/com/astral/typer/SettingsActivity.kt
+++ app/src/main/java/com/astral/typer/SettingsActivity.kt
@@ -191,6 +191,55 @@
         updateWatermarkPreview()

+        // Cloudflare Setup
+        val cbCloudflareAI = findViewById<android.widget.CheckBox>(R.id.cbCloudflareAI)
+        val layoutCloudflareSettings = findViewById<android.widget.LinearLayout>(R.id.layoutCloudflareSettings)
+        val etCloudflareUrl = findViewById<android.widget.EditText>(R.id.etCloudflareUrl)
+        val etCloudflareApiKey = findViewById<android.widget.EditText>(R.id.etCloudflareApiKey)
+        val etCloudflarePrompt = findViewById<android.widget.EditText>(R.id.etCloudflarePrompt)
+
+        val cloudflareEnabled = settingsPrefs.getBoolean("cloudflare_ai_enabled", false)
+        cbCloudflareAI.isChecked = cloudflareEnabled
+        layoutCloudflareSettings.visibility = if (cloudflareEnabled) android.view.View.VISIBLE else android.view.View.GONE
+
+        etCloudflareUrl.setText(settingsPrefs.getString("cloudflare_url", ""))
+        etCloudflareApiKey.setText(settingsPrefs.getString("cloudflare_apikey", ""))
+        etCloudflarePrompt.setText(settingsPrefs.getString("cloudflare_prompt", "Removing text or sfx in comic"))
+
+        cbCloudflareAI.setOnCheckedChangeListener { _, isChecked ->
+            settingsPrefs.edit().putBoolean("cloudflare_ai_enabled", isChecked).apply()
+            layoutCloudflareSettings.visibility = if (isChecked) android.view.View.VISIBLE else android.view.View.GONE
+        }
+
+        etCloudflareUrl.addTextChangedListener(object : android.text.TextWatcher {
+            override fun beforeTextChanged(s: CharSequence?, start: Int, count: Int, after: Int) {}
+            override fun onTextChanged(s: CharSequence?, start: Int, before: Int, count: Int) {}
+            override fun afterTextChanged(s: android.text.Editable?) {
+                settingsPrefs.edit().putString("cloudflare_url", s.toString()).apply()
+            }
+        })
+
+        etCloudflareApiKey.addTextChangedListener(object : android.text.TextWatcher {
+            override fun beforeTextChanged(s: CharSequence?, start: Int, count: Int, after: Int) {}
+            override fun onTextChanged(s: CharSequence?, start: Int, before: Int, count: Int) {}
+            override fun afterTextChanged(s: android.text.Editable?) {
+                settingsPrefs.edit().putString("cloudflare_apikey", s.toString()).apply()
+            }
+        })
+
+        etCloudflarePrompt.addTextChangedListener(object : android.text.TextWatcher {
+            override fun beforeTextChanged(s: CharSequence?, start: Int, count: Int, after: Int) {}
+            override fun onTextChanged(s: CharSequence?, start: Int, before: Int, count: Int) {}
+            override fun afterTextChanged(s: android.text.Editable?) {
+                val txt = s.toString()
+                if (txt.isEmpty()) {
+                    settingsPrefs.edit().putString("cloudflare_prompt", "Removing text or sfx in comic").apply()
+                } else {
+                    settingsPrefs.edit().putString("cloudflare_prompt", txt).apply()
+                }
+            }
+        })
+
         // PDF Quality Logic
         tvPdfQuality = findViewById(R.id.tvPdfQuality)
         sbPdfQuality = findViewById(R.id.sbPdfQuality)
